{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:5173", "http://localhost:4173", "https://*.pages.dev"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-Match"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
