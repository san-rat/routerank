# The routing graph the API loads (built with ./gradlew buildGraph, uploaded with data/graph/upload.sh).
# It must come from the same OSM extract as the road segments in the database, or the API refuses to start.
# The deploy downloads it to ~/routerank/graphs on the VM when missing and checks the SHA-256.
GRAPH=graph-2026-10-01
GRAPH_URL=https://pub-18c1a444c42345c6b9bdb097262408a0.r2.dev/graphs/graph-2026-10-01.tar.gz
GRAPH_SHA256=6c80294266778a74351923a141e852d6b9320af905987a29880d07205fdabb9b
