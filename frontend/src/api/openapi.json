{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "RouteRank API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/routes/{id}" : {
      "put" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "update",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RouteInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RouteView"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "remove",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/routes/order" : {
      "put" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "reorder",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Order"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MyRoutes"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes" : {
      "get" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MyRoutes"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RouteInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RouteView"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes/preview" : {
      "post" : {
        "tags" : [ "routes-controller" ],
        "operationId" : "preview",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RouteInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Preview"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/google" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "google",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GoogleSignIn"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "401" : {
            "description" : "Unauthorized"
          },
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/scoring/run" : {
      "post" : {
        "tags" : [ "admin-controller" ],
        "operationId" : "runScoring",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Run"
                }
              }
            }
          }
        }
      }
    },
    "/api/places" : {
      "get" : {
        "tags" : [ "places-controller" ],
        "operationId" : "search",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 60,
            "minLength" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Place"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me" : {
      "get" : {
        "tags" : [ "me-controller" ],
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/nonce" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "nonce",
        "responses" : {
          "401" : {
            "description" : "Unauthorized"
          },
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Nonce"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "LatLon" : {
        "type" : "object",
        "properties" : {
          "lat" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 10.2,
            "minimum" : 5.5
          },
          "lon" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 82.2,
            "minimum" : 79.3
          }
        }
      },
      "RouteInput" : {
        "type" : "object",
        "properties" : {
          "start" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "end" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "waypoints" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LatLon"
            },
            "maxItems" : 8,
            "minItems" : 0
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 3,
            "minimum" : 1
          },
          "routeId" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "end", "start", "waypoints" ]
      },
      "Busiest" : {
        "type" : "object",
        "properties" : {
          "slug" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "points" : {
            "type" : "integer",
            "format" : "int32"
          },
          "people" : {
            "type" : "integer",
            "format" : "int32"
          },
          "rank" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "RouteView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "start" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "end" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "waypoints" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LatLon"
            }
          },
          "out" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "back" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "lengthOutM" : {
            "type" : "number",
            "format" : "double"
          },
          "lengthBackM" : {
            "type" : "number",
            "format" : "double"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "busiest" : {
            "$ref" : "#/components/schemas/Busiest"
          }
        },
        "required" : [ "back", "createdAt", "end", "id", "lengthBackM", "lengthOutM", "name", "out", "slot", "start", "updatedAt", "waypoints" ]
      },
      "Order" : {
        "type" : "object",
        "properties" : {
          "routes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SlotAssignment"
            },
            "maxItems" : 3,
            "minItems" : 0
          }
        },
        "required" : [ "routes" ]
      },
      "SlotAssignment" : {
        "type" : "object",
        "properties" : {
          "routeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 3,
            "minimum" : 1
          }
        },
        "required" : [ "routeId", "slot" ]
      },
      "MyRoutes" : {
        "type" : "object",
        "properties" : {
          "routes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/RouteView"
            }
          },
          "slots" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SlotView"
            }
          },
          "countsFrom" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "SlotView" : {
        "type" : "object",
        "properties" : {
          "slot" : {
            "type" : "integer",
            "format" : "int32"
          },
          "lockedUntil" : {
            "type" : "string",
            "format" : "date-time"
          },
          "graceUntil" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "slot" ]
      },
      "Preview" : {
        "type" : "object",
        "properties" : {
          "points" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LatLon"
            }
          },
          "out" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "back" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "backLeaves" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "array",
                "items" : {
                  "type" : "number",
                  "format" : "double"
                }
              }
            }
          },
          "backVia" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "lengthOutM" : {
            "type" : "number",
            "format" : "double"
          },
          "lengthBackM" : {
            "type" : "number",
            "format" : "double"
          },
          "name" : {
            "type" : "string"
          },
          "problems" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Problem"
            }
          }
        }
      },
      "Problem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "SIDE_ROAD", "NO_ROAD_NEARBY", "NO_ROUTE", "NO_WAY_BACK", "TOO_LONG", "OVERLAP", "SLOT_LOCKED", "SLOTS_FULL" ]
          },
          "point" : {
            "type" : "string"
          },
          "nearest" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "lengthM" : {
            "type" : "number",
            "format" : "double"
          },
          "limitM" : {
            "type" : "number",
            "format" : "double"
          },
          "routeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32"
          },
          "routeName" : {
            "type" : "string"
          },
          "until" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "code" ]
      },
      "GoogleSignIn" : {
        "type" : "object",
        "properties" : {
          "credential" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "credential" ]
      },
      "Me" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "email" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "liveAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Run" : {
        "type" : "object",
        "properties" : {
          "at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "segments" : {
            "type" : "integer",
            "format" : "int32"
          },
          "stretches" : {
            "type" : "integer",
            "format" : "int32"
          },
          "ranked" : {
            "type" : "integer",
            "format" : "int32"
          },
          "uploaded" : {
            "type" : "integer",
            "format" : "int32"
          },
          "deleted" : {
            "type" : "integer",
            "format" : "int32"
          },
          "published" : {
            "type" : "boolean"
          },
          "note" : {
            "type" : "string"
          }
        }
      },
      "Place" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "lat" : {
            "type" : "number",
            "format" : "double"
          },
          "lon" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "Nonce" : {
        "type" : "object",
        "properties" : {
          "nonce" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
