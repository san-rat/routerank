  "components" : {
    "schemas" : {
      "LatLon" : {
        "type" : "object",
        "properties" : {
          "lat" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 10.2,
            "minimum" : 5.5
          },
          "lon" : {
            "type" : "number",
            "format" : "double",
            "maximum" : 82.2,
            "minimum" : 79.3
          }
        }
      },
      "RouteInput" : {
        "type" : "object",
        "properties" : {
          "start" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "end" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "waypoints" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LatLon"
            },
            "maxItems" : 8,
            "minItems" : 0
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 3,
            "minimum" : 1
          },
          "routeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "extend" : {
            "type" : "integer",
            "format" : "int64"
          },
          "turnstile" : {
            "type" : "string",
            "maxLength" : 2048,
            "minLength" : 0
          },
          "device" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "website" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "end", "start", "waypoints" ]
      },
      "BusRef" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "number" : {
            "type" : "string"
          }
        }
      },
      "Busiest" : {
        "type" : "object",
        "properties" : {
          "slug" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "points" : {
            "type" : "integer",
            "format" : "int32"
          },
          "people" : {
            "type" : "integer",
            "format" : "int32"
          },
          "rank" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "RouteView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "start" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "end" : {
            "$ref" : "#/components/schemas/LatLon"
          },
          "waypoints" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LatLon"
            }
          },
          "out" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "back" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          },
          "lengthOutM" : {
            "type" : "number",
            "format" : "double"
          },
          "lengthBackM" : {
            "type" : "number",
            "format" : "double"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "busiest" : {
            "$ref" : "#/components/schemas/Busiest"
          },
          "extendsBus" : {
            "$ref" : "#/components/schemas/BusRef"
          }
        },
        "required" : [ "back", "createdAt", "end", "id", "lengthBackM", "lengthOutM", "name", "out", "slot", "start", "updatedAt", "waypoints" ]
      },
      "Order" : {
        "type" : "object",
        "properties" : {
          "routes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SlotAssignment"
            },
            "maxItems" : 3,
            "minItems" : 0
          }
        },
        "required" : [ "routes" ]
      },
      "SlotAssignment" : {
        "type" : "object",
        "properties" : {
          "routeId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "slot" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 3,
            "minimum" : 1
          }
        },
        "required" : [ "routeId", "slot" ]
      },
      "MyRoutes" : {
        "type" : "object",
        "properties" : {
          "routes" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/RouteView"
            }
          },
          "slots" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SlotView"
